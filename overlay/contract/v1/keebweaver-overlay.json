      "firmwareIndex": 2,
      "title": "Numbers",
      "instruction": "Hold the Num thumb key"
    },
    {
      "id": "symbols",
      "firmwareIndex": 3,
      "title": "Symbols",
      "instruction": "Hold the Space / Sym thumb key"
    }
  ],
